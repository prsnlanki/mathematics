#!/usr/bin/env bash
# The checks every change must pass, run on this machine by `local-ci` (claude-toolkit)
# in place of GitHub Actions. Run it directly to check without posting a status.
# Builds the deck (each subdeck checks its own notes), then imports it into a throwaway
# Anki collection with the real `anki` package. The built .apkg is git-ignored.
set -euo pipefail
cd "$(dirname "$0")"
scripts/check-release-links.sh
uv run --no-project -q -p 3.13 --with genanki==0.13.1 python build.py
uv run --no-project -q -p 3.13 --with genanki==0.13.1 --with anki==26.9.4 python tests/test_import.py
